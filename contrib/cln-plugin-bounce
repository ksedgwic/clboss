#!/bin/sh
# cln-plugin-bounce - stop and restart running CLN plugins without
# restarting lightningd.
#
# usage: cln-plugin-bounce [lightning-cli options...] <plugin-name>...
#
# "plugin stop" requires a plugin's exact registered name, which for
# versioned installs includes the version string (e.g.
# /usr/local/bin/xrebalance-v0.4.1).  This script looks each exact
# name up from "plugin list", stops the plugins in the order given,
# then starts them again in reverse order, so the list order encodes
# any shutdown dependency between them.  When an unversioned sibling
# path exists (usually a symlink maintained by the install script),
# the restart uses that, so a repointed symlink brings up the new
# version.
#
# A restarted plugin gets the option values lightningd holds: the
# ones it read from its config files at its own startup, as changed
# since by setconfig.  A live change is made with setconfig; an edit
# to a config file takes effect when lightningd restarts.
#
# Plugin names are the arguments that do not start with "-"; each is
# a short name ("clboss", "xrebalance"), or a full versioned basename
# if the short name matches more than one running plugin.  All other
# arguments are passed to every lightning-cli call, so names and
# options may appear in any order:
#   cln-plugin-bounce --signet --lightning-dir="$CLNDIR" xrebalance clboss
# Set $LIGHTNING_CLI to override the lightning-cli binary.

set -eu

me=${0##*/}

names=
rebuilt=
for arg do
	[ -n "$rebuilt" ] || { set --; rebuilt=1; }
	if [ "${arg#-}" = "$arg" ]; then
		names="${names}${arg}
"
	else
		set -- "$@" "$arg"
	fi
done

if [ -z "$names" ]; then
	echo "usage: $me [lightning-cli options...] <plugin-name>..." >&2
	exit 2
fi

lcli=${LIGHTNING_CLI:-lightning-cli}

if ! command -v jq >/dev/null; then
	echo "$me: jq is required" >&2
	exit 1
fi

# Registered paths whose basename is <name> or <name>-<anything>.
match='.plugins[].name
	| select((sub(".*/"; "")) as $b
		| $b == $n or ($b | startswith($n + "-")))'

# Resolve every name before touching anything, from one snapshot.
plugins=$("$lcli" "$@" plugin list)

resolved=
while IFS= read -r n; do
	[ -n "$n" ] || continue
	running=$(printf '%s\n' "$plugins" | jq -r --arg n "$n" "$match")
	if [ -z "$running" ]; then
		echo "$me: no running plugin matches '$n'" >&2
		exit 1
	fi
	if [ "$(printf '%s\n' "$running" | wc -l)" -gt 1 ]; then
		echo "$me: '$n' matches more than one running plugin:" >&2
		printf '%s\n' "$running" >&2
		exit 1
	fi
	resolved="${resolved}${n} ${running}
"
done <<EOF
$names
EOF

# The options of the named plugins that lightningd holds from a
# config file or a setconfig, one name per line.  Taken before the
# stops, since a stopped plugin's options leave listconfigs.  An
# option that a newly installed build no longer registers leaves
# lightningd holding a stale configvar until it restarts, and a
# setconfig before then crashes lightningd without the configvar fix
# (through at least v26.04); the check after the starts warns about
# any such option.
configured=$("$lcli" "$@" listconfigs | jq -r '
	.configs | to_entries[]
	| select(.value.plugin? != null)
	| select((.value.source? // "default") != "default"
	      or ((.value.sources? // []) | length) > 0)
	| "\(.key)\t\(.value.plugin)"')
watch=
while read -r n path; do
	[ -n "$n" ] || continue
	watch="${watch}$(printf '%s\n' "$configured" \
		| awk -F'\t' -v p="$path" '$2 == p { print $1 }')
"
done <<EOF
$resolved
EOF

# Stop in the order given.
stopped_names=
tostart=
while read -r n path; do
	[ -n "$n" ] || continue
	echo "stopping $path"
	if ! "$lcli" "$@" plugin stop "$path" >/dev/null; then
		echo "$me: stop failed for $path" >&2
		if [ -n "$stopped_names" ]; then
			echo "$me: already stopped, not restarted:$stopped_names" >&2
		fi
		exit 1
	fi
	stopped_names="$stopped_names $n"
	tostart="${n} ${path}
${tostart}"
done <<EOF
$resolved
EOF

# Start plugin (short name $1, stopped path $2), preferring the
# unversioned sibling and falling back to the exact path.  The rest
# of the arguments are the lightning-cli options.
start_plugin() {
	sp_n=$1
	sp_path=$2
	shift 2
	sp_start=$(dirname "$sp_path")/$sp_n
	[ -e "$sp_start" ] || sp_start=$sp_path
	echo "starting $sp_start"
	if "$lcli" "$@" plugin start "$sp_start" </dev/null >/dev/null; then
		return 0
	fi
	if [ "$sp_start" != "$sp_path" ]; then
		echo "$me: start failed; retrying with $sp_path" >&2
		if "$lcli" "$@" plugin start "$sp_path" </dev/null >/dev/null; then
			return 0
		fi
	fi
	echo "$me: failed to start $sp_n" >&2
	return 1
}

# Start in reverse order.
failed=
while read -r n path; do
	[ -n "$n" ] || continue
	start_plugin "$n" "$path" "$@" || failed=1
done <<EOF
$tostart
EOF

# Warn about configured options the restarted plugins no longer
# register (see above).
if [ -n "$watch" ]; then
	configs=$("$lcli" "$@" listconfigs)
	dropped=
	while IFS= read -r k; do
		[ -n "$k" ] || continue
		printf '%s\n' "$configs" \
			| jq -e --arg k "$k" '.configs | has($k)' >/dev/null \
			|| dropped="$dropped $k"
	done <<EOF
$watch
EOF
	if [ -n "$dropped" ]; then
		echo "$me: warning: no longer registered by the restarted plugins:$dropped" >&2
		echo "$me: lightningd keeps a stale configvar for each until it restarts; remove or comment the line(s) and restart lightningd before any setconfig." >&2
	fi
fi

plugins=$("$lcli" "$@" plugin list)
while IFS= read -r n; do
	[ -n "$n" ] || continue
	printf '%s\n' "$plugins" | jq -r --arg n "$n" "$match" \
		| sed 's/^/now running /'
done <<EOF
$names
EOF

[ -z "$failed" ] || exit 1
